# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# ---- IA que escreve as respostas
MAIND_IA_CHAVE=

# ---- Partes ligadas
# Perfis prontos para o experimento comparativo:
#   completo | so_ia | ia_tema | ia_tema_conhecimento
MAIND_PERFIL=completo
# Ou force cada parte individualmente (1 = ligada, 0 = desligada):
# MAIND_PARTE_SEGURANCA=1
# MAIND_PARTE_TEMA=1
# MAIND_PARTE_INTENCAO=1
# MAIND_PARTE_CONHECIMENTO=1

# ---- Comportamento
# A partir de que confiança o bot segue com o tema
MAIND_LIMIAR=0.5
# Tempo máximo para a IA responder, em segundos
MAIND_TIMEOUT_IA_S=20
# Quantas mensagens anteriores as partes e a IA recebem
MAIND_HISTORICO_MAX=20

# ---- Memória da conversa
# 1 = guarda em dados/conversas.db (sobrevive a reinícios); 0 = só na memória do processo
MAIND_GUARDAR_CONVERSAS=1
# MAIND_BANCO=dados/conversas.db

# ---- Servidor
MAIND_PORTA=8000
